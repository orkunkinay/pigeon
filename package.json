{
  "name": "@pigeon-dev/cli",
  "version": "0.1.0",
  "description": "Your coding agent is one message away. Local Codex to Slack communication.",
  "type": "module",
  "bin": {
    "pigeon": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "slack-manifest.json"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "format": "prettier --write src tests scripts",
    "format:check": "prettier --check src tests scripts",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "dependencies": {
    "@slack/bolt": "^5.1.0",
    "@slack/web-api": "^8.4.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Murat-Barkin-Kinay/pigeon.git"
  },
  "keywords": [
    "pigeon",
    "codex",
    "slack",
    "local-first",
    "coding-agent"
  ],
  "publishConfig": {
    "access": "public"
  }
}
